load("@score_tooling//:defs.bzl", "score_py_pytest")

score_py_pytest(
    name = "gatewayd_test",
    srcs = ["gatewayd_test.py"],
    data = [
        "//score/config:config_file",
        "//score/gatewayd",
        "//score/gatewayd:etc/mw_com_config.json",
        "//score/serializer:null_serializer",
        "//score/someipd",
        "//score/someipd:etc/mw_com_config.json",
    ],
    env = {
        "CONFIGURATION": "$(location //score/config:config_file)",
        "GATEWAYD": "$(location //score/gatewayd:gatewayd)",
        "SERVICE_INSTANCE_MANIFEST": "$(location //score/gatewayd:etc/mw_com_config.json)",
        "SOMEIPD": "$(location //score/someipd:someipd)",
        "SOMEIPD_SERVICE_INSTANCE_MANIFEST": "$(location //score/someipd:etc/mw_com_config.json)",
    },
    tags = [
        "block-network",
        "unit",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    deps = [
        "//quality/pytest:process",
    ],
)
